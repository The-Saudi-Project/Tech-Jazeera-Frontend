# Copy this file to keystore.properties (same folder) and fill in your real
# values. keystore.properties is gitignored — never commit your real
# passwords. storeFile is resolved relative to this file's own folder
# (client/android/), so if your .keystore file sits at the repo root, use
# ../../<filename>.keystore as shown below.
storeFile=../../aj-crm-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=aj-crm
keyPassword=YOUR_KEY_PASSWORD
