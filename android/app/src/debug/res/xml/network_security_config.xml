<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only: allows plaintext HTTP to the Android emulator's
  host-loopback alias, so the app can reach the local dev server at
  http://10.0.2.2:5000 during development. This file lives under
  src/debug/, not src/main/, so it never applies to a release build,
  which talks to a real HTTPS backend and needs no exception.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
